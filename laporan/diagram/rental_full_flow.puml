@startuml rental_full_flow
title Diagram Activity - Alur Peminjaman Lengkap

skinparam ActivityBorderColor #333333
skinparam ActivityBackgroundColor #f5f5f5
skinparam ActivityDiamondBackgroundColor #fff8dc
skinparam ActivityDiamondBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #666666
skinparam SwimlaneTitleFontStyle bold
skinparam swimlaneWidth same
skinparam Padding 2
skinparam ParticipantPadding 2
skinparam defaultFontSize 12

|Peminjam|
start
:Buka Halaman Produk;
:Isi Tanggal Awal & Akhir;
:Klik Sewa;

|Sistem|
:Status: Menunggu Persetujuan Pemilik\nNotifikasi dikirim ke Pemilik;

|Pemilik|
if (Keputusan?) then (Setuju)

  |Sistem|
  :Status: Siap\nNotifikasi dikirim ke Peminjam;

  |Peminjam|
  :Tunggu Waktu Mulai Sewa;
  :Klik Terima;

  |Sistem|
  :Status: Menunggu Penyerahan\nNotifikasi dikirim ke Pemilik;

  |Pemilik|
  :Isi Pembayaran Awal;
  :Submit;

  |Sistem|
  :Status: Dalam Peminjaman\nNotifikasi dikirim ke Peminjam;

  |Peminjam|
  :Tunggu Masa Sewa Selesai;
  :Klik Kembalikan Barang;

  |Sistem|
  :Status: Menunggu Konfirmasi Pengembalian\nNotifikasi dikirim ke Pemilik;

  |Pemilik|
  :Isi Pembayaran Akhir,\nDenda Telat & Kerusakan;
  :Submit;

  |Sistem|
  :Status: Selesai\nNotifikasi dikirim ke Peminjam;
  stop

else (Tolak)

  |Pemilik|
  :Isi Alasan Penolakan;
  :Submit;

  |Sistem|
  :Status: Batal\nNotifikasi dikirim ke Peminjam;
  stop

endif
@enduml
