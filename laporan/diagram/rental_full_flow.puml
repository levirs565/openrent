@startuml rental_full_flow
title Diagram Activity - Alur Peminjaman Lengkap

skinparam ActivityBorderColor #333333
skinparam ActivityBackgroundColor #f5f5f5
skinparam ActivityDiamondBackgroundColor #fff8dc
skinparam ActivityDiamondBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #666666
skinparam SwimlaneTitleFontStyle bold
skinparam defaultFontSize 11
skinparam Padding 2

|Peminjam|
start
:Buka Halaman Produk;
:Isi Tanggal\nAwal & Akhir;
:Klik Sewa;

|Sistem|
:Status: Menunggu\nPersetujuan Pemilik\nNotifikasi ke Pemilik;

|Pemilik|
if (Keputusan?) then (Setuju)

  |Sistem|
  :Status: Siap\nNotifikasi ke Peminjam;

  |Peminjam|
  :Tunggu Waktu\nMulai Sewa;
  :Klik Terima;

  |Sistem|
  :Status: Menunggu\nPenyerahan\nNotifikasi ke Pemilik;

  |Pemilik|
  :Isi Pembayaran Awal;
  :Submit;

  |Sistem|
  :Status: Dalam\nPeminjaman\nNotifikasi ke Peminjam;

  |Peminjam|
  :Tunggu Masa\nSewa Selesai;
  :Klik Kembalikan\nBarang;

  |Sistem|
  :Status: Menunggu\nKonfirmasi Pengembalian\nNotifikasi ke Pemilik;

  |Pemilik|
  :Isi Pembayaran Akhir,\nDenda Telat\n& Kerusakan;
  :Submit;

  |Sistem|
  :Status: Selesai\nNotifikasi ke Peminjam;
  stop

else (Tolak)

  |Pemilik|
  :Isi Alasan\nPenolakan;
  :Submit;

  |Sistem|
  :Status: Batal\nNotifikasi ke Peminjam;
  stop

endif
@enduml
