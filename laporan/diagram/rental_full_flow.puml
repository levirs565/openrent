@startuml rental_full_flow
title Diagram Activity - Alur Peminjaman Lengkap

skinparam ActivityBorderColor #333333
skinparam ActivityBackgroundColor #f5f5f5
skinparam ActivityDiamondBackgroundColor #fff8dc
skinparam ActivityDiamondBorderColor #333333
skinparam ArrowColor #333333
skinparam SwimlaneBorderColor #666666
skinparam SwimlaneTitleFontStyle bold
skinparam wrapWidth 200

|Peminjam|
start
:Buka Halaman Produk;
:Pilih Tanggal Awal dan Akhir;
:Klik Sewa;

|Sistem|
:Status: Menunggu Persetujuan Pemilik;
:Kirim Notifikasi ke Pemilik;

|Pemilik|
if (Keputusan Pemilik?) then (Setuju)

  |Sistem|
  :Status: Siap;
  :Kirim Notifikasi ke Peminjam;

  |Peminjam|
  :Menunggu Waktu Peminjaman Dimulai;
  :Klik Terima;

  |Sistem|
  :Status: Menunggu Penyerahan dari Pemilik;
  :Kirim Notifikasi ke Pemilik;

  |Pemilik|
  :Isi Pembayaran Awal;
  :Submit;

  |Sistem|
  :Status: Dalam Peminjaman;
  :Kirim Notifikasi ke Peminjam;

  |Peminjam|
  :Menunggu Masa Peminjaman Selesai;
  :Klik Kembalikan Barang;

  |Sistem|
  :Status: Menunggu Konfirmasi Pengembalian;
  :Kirim Notifikasi ke Pemilik;

  |Pemilik|
  :Isi Pembayaran Akhir,\nDenda Keterlambatan,\ndan Denda Kerusakan;
  :Submit;

  |Sistem|
  :Status: Selesai;
  :Kirim Notifikasi ke Peminjam;
  stop
else (Tolak)

  |Pemilik|
  :Isi Alasan Penolakan;
  :Submit;

  |Sistem|
  :Status: Batal;
  :Kirim Notifikasi ke Peminjam;
  stop
endif


@enduml
